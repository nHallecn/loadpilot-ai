# Copy to apps/web/.env.local, fill with private values, NEVER commit .env.local.
# Backend and frontend must run in the same Codespace/local machine.
LOADPILOT_API_BASE_URL=http://127.0.0.1:4000
# EXACT value of LOADPILOT_DEMO_TOKEN in apps/api/.env (server-side only):
LOADPILOT_BACKEND_TOKEN=replace_with_existing_api_demo_token
# A DIFFERENT random secret at least 24 characters long, entered in the dashboard UI:
DASHBOARD_ACCESS_TOKEN=replace_with_new_random_dashboard_secret
